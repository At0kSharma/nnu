---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import Container from '../components/Container.astro'
import Footer from '../components/Footer.astro'
import { site } from '../data/site'
---

<Base title="Page not found" description="That page does not exist on this site.">
  <Header />
  <main class="bg-ground py-20 md:py-28">
    <Container>
      <div class="max-w-[52ch]">
        <span class="mb-4 flex items-center gap-3 text-sm text-ink-muted">
          <span aria-hidden="true" class="h-px w-8 bg-hairline-strong"></span>
          404
        </span>
        <h1
          class="font-display text-4xl leading-tight font-semibold tracking-tight text-ink md:text-5xl"
        >
          Page not found
        </h1>
        <p class="mt-3 leading-relaxed text-ink-muted">
          That page does not exist. Everything on this site lives on the front page — the seating
          range and how to reach us.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="/"
            class="rounded-card border border-ink bg-ink px-5 py-2.5 text-sm font-medium text-ground transition-colors hover:bg-transparent hover:text-ink"
          >
            Back to the front page
          </a>
          <a
            href="/#contact"
            class="rounded-card border border-hairline-strong px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-ink"
          >
            {site.hero.ctaContact}
          </a>
        </div>
      </div>
    </Container>
  </main>
  <Footer />
</Base>
