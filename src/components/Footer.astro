---
import Container from './Container.astro'
import { site, whatsappLink, telLink } from '../data/site'

const year = new Date().getFullYear()
---

<footer class="bg-band pb-10 text-band-ink">
  <Container>
    <div class="grid gap-8 border-t border-band-ink/12 py-10 sm:grid-cols-2 md:grid-cols-3">
      <div>
        <div class="flex items-center gap-2.5 font-display text-base font-semibold tracking-tight">
          <img src="/icon-192.png" alt="" width="26" height="26" class="size-6.5 rounded-sm" />
          {site.name}
        </div>
        <p class="mt-3 text-sm leading-relaxed text-band-ink/70">{site.tagline}</p>
        <p class="mt-2 text-sm leading-relaxed text-band-ink/70">{site.contact.address}</p>
      </div>

      <div>
        <h2 class="text-sm font-medium">Seating</h2>
        <ul class="mt-3 list-none space-y-2 p-0 text-sm text-band-ink/70">
          <li><a href="#cinema" class="hover:text-band-ink">Cinema chairs</a></li>
          <li><a href="#auditorium" class="hover:text-band-ink">Auditorium chairs</a></li>
          <li><a href="#contact" class="hover:text-band-ink">Contact</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-medium">Contact</h2>
        <ul class="mt-3 list-none space-y-2 p-0 text-sm text-band-ink/70">
          <li><a href={telLink} class="hover:text-band-ink">{site.contact.phone}</a></li>
          <li>
            <a href={`mailto:${site.contact.email}`} class="hover:text-band-ink">
              {site.contact.email}
            </a>
          </li>
          <li>
            <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="hover:text-band-ink">
              WhatsApp
            </a>
          </li>
          <li>
            <a href={site.contact.facebook} target="_blank" rel="noopener noreferrer" class="hover:text-band-ink">
              Facebook
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="flex flex-wrap items-center justify-between gap-3 border-t border-band-ink/12 pt-6 text-sm text-band-ink/60"
    >
      <span>&copy; {year} {site.name}. All rights reserved.</span>
      <span>{site.footer.note}</span>
    </div>
  </Container>
</footer>
