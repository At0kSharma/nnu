---
import Container from './Container.astro'
import { site, whatsappLink, telLink } from '../data/site'

const rows = [
  { label: 'Phone', value: site.contact.phone, href: telLink },
  { label: 'Email', value: site.contact.email, href: `mailto:${site.contact.email}` },
  { label: 'Address', value: site.contact.address, href: null },
]
---

<section id="contact" class="border-t border-hairline bg-band py-16 text-band-ink md:py-24">
  <Container>
    <div class="grid gap-10 md:grid-cols-2 md:gap-16">
      <div class="max-w-[52ch]">
        <h2
          class="font-display text-3xl leading-tight font-semibold tracking-tight md:text-4xl"
        >
          {site.contact.heading}
        </h2>
        <p class="mt-3 leading-relaxed text-band-ink/70">{site.contact.intro}</p>

        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-card bg-band-ink px-5 py-2.5 text-sm font-medium text-band transition-opacity hover:opacity-90"
          >
            Message on WhatsApp
          </a>
          <a
            href={telLink}
            class="rounded-card border border-band-ink/30 px-5 py-2.5 text-sm font-medium text-band-ink transition-colors hover:border-band-ink"
          >
            Call {site.contact.phone}
          </a>
        </div>
      </div>

      <dl class="divide-y divide-band-ink/12 border-y border-band-ink/12">
        {
          rows.map((row) => (
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
              <dt class="text-sm text-band-ink/60">{row.label}</dt>
              <dd class="text-right font-medium">
                {row.href ? (
                  <a href={row.href} class="underline-offset-4 hover:underline">
                    {row.value}
                  </a>
                ) : (
                  row.value
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Container>
</section>
